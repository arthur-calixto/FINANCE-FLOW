// Schema v1. Invariantes e decisões: docs/database.md.
// CHECKs são mantidos manualmente na migration SQL; Prisma 7 não os expressa aqui.
datasource db {
  provider = "postgresql"
}

enum WorkspaceType {
  PERSONAL
  FAMILY
  BUSINESS
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum AccountType {
  CHECKING
  SAVINGS
  CASH
  INVESTMENT
  OTHER
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum RecurrenceFrequency {
  MONTHLY
  YEARLY
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
  OVERDUE
}

model User {
  id                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                    String             @unique
  name                     String
  avatarUrl                String?
  createdAt                DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime           @updatedAt @db.Timestamptz(3)
  ownedWorkspaces          Workspace[]
  memberships              WorkspaceMember[]
  createdTransactions      Transaction[]
  createdInstallmentGroups InstallmentGroup[]
  createdRecurrences       Recurrence[]
  createdTransfers         Transfer[]
}

model Workspace {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  type               WorkspaceType
  ownerId            String              @db.Uuid
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  workspaceMembers   WorkspaceMember[]
  accounts           Account[]
  categories         Category[]
  transactions       Transaction[]
  installmentGroups  InstallmentGroup[]
  recurrences        Recurrence[]
  creditCards        CreditCard[]
  creditCardInvoices CreditCardInvoice[]
  transfers          Transfer[]

  @@index([ownerId])
}

model WorkspaceMember {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String        @db.Uuid
  userId       String        @db.Uuid
  role         WorkspaceRole
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  accounts     Account[]
  creditCards  CreditCard[]
  transactions Transaction[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, userId])
  @@index([userId])
}

model Account {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String             @db.Uuid
  name               String
  type               AccountType
  initialBalance     Decimal            @default(0) @db.Decimal(19, 2)
  currency           String             @default("BRL") @db.VarChar(3)
  ownerMemberId      String?            @db.Uuid
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ownerMember        WorkspaceMember?   @relation(fields: [workspaceId, ownerMemberId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  transactions       Transaction[]
  installmentGroups  InstallmentGroup[]
  recurrences        Recurrence[]
  paymentCreditCards CreditCard[]
  outgoingTransfers  Transfer[]         @relation("TransferSource")
  incomingTransfers  Transfer[]         @relation("TransferDestination")

  @@unique([workspaceId, id])
  @@index([workspaceId, ownerMemberId])
}

model Category {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String             @db.Uuid
  parentId          String?            @db.Uuid
  name              String
  type              CategoryType
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  parent            Category?          @relation("CategoryHierarchy", fields: [workspaceId, parentId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  children          Category[]         @relation("CategoryHierarchy")
  transactions      Transaction[]
  installmentGroups InstallmentGroup[]
  recurrences       Recurrence[]

  @@unique([workspaceId, id])
  @@index([workspaceId, parentId])
}

/// CHECKs SQL: expectedAmount e amount positivos quando presentes.
/// Service: exige expectedAmount ou amount; PAID exige amount e paidAt.
/// Service: invoice.creditCardId deve coincidir com creditCardId.
/// Service: installmentNumber entre 1 e installmentGroup.installmentCount.
model Transaction {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String             @db.Uuid
  description        String
  type               TransactionType
  status             TransactionStatus  @default(PENDING)
  expectedAmount     Decimal?           @db.Decimal(19, 2)
  amount             Decimal?           @db.Decimal(19, 2)
  transactionDate    DateTime           @db.Date
  competenceDate     DateTime           @db.Date
  dueDate            DateTime           @db.Date
  paidAt             DateTime?          @db.Timestamptz(3)
  accountId          String?            @db.Uuid
  categoryId         String?            @db.Uuid
  creditCardId       String?            @db.Uuid
  invoiceId          String?            @db.Uuid
  installmentGroupId String?            @db.Uuid
  recurrenceId       String?            @db.Uuid
  ownerMemberId      String?            @db.Uuid
  installmentNumber  Int?
  /// Deve identificar membro autorizado deste workspace no momento da criação.
  createdBy          String             @db.Uuid
  notes              String?
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator            User               @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ownerMember        WorkspaceMember?   @relation(fields: [workspaceId, ownerMemberId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  account            Account?           @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  category           Category?          @relation(fields: [workspaceId, categoryId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  creditCard         CreditCard?        @relation(fields: [workspaceId, creditCardId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  invoice            CreditCardInvoice? @relation(fields: [workspaceId, invoiceId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  installmentGroup   InstallmentGroup?  @relation(fields: [workspaceId, installmentGroupId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  recurrence         Recurrence?        @relation(fields: [workspaceId, recurrenceId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([installmentGroupId, installmentNumber])
  @@index([workspaceId, competenceDate])
  @@index([workspaceId, dueDate])
  @@index([workspaceId, status, dueDate])
  @@index([workspaceId, accountId])
  @@index([workspaceId, categoryId])
  @@index([workspaceId, creditCardId])
  @@index([workspaceId, invoiceId])
  @@index([workspaceId, recurrenceId])
  @@index([workspaceId, installmentGroupId])
  @@index([workspaceId, ownerMemberId])
  @@index([createdBy])
}

/// CHECKs SQL: installmentCount > 0 e totalAmount positivo.
model InstallmentGroup {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String        @db.Uuid
  description      String
  totalAmount      Decimal       @db.Decimal(19, 2)
  installmentCount Int
  purchaseDate     DateTime      @db.Date
  categoryId       String?       @db.Uuid
  accountId        String?       @db.Uuid
  creditCardId     String?       @db.Uuid
  /// Deve identificar membro autorizado deste workspace no momento da criação.
  createdBy        String        @db.Uuid
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)
  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator          User          @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  account          Account?      @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  category         Category?     @relation(fields: [workspaceId, categoryId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  creditCard       CreditCard?   @relation(fields: [workspaceId, creditCardId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  transactions     Transaction[]

  @@unique([workspaceId, id])
  @@index([workspaceId, categoryId])
  @@index([workspaceId, accountId])
  @@index([workspaceId, creditCardId])
  @@index([createdBy])
}

/// CHECKs SQL: dueDay entre 1 e 31, interval > 0, expectedAmount positivo.
model Recurrence {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String              @db.Uuid
  description        String
  type               TransactionType
  expectedAmount     Decimal             @db.Decimal(19, 2)
  categoryId         String?             @db.Uuid
  accountId          String?             @db.Uuid
  frequency          RecurrenceFrequency
  interval           Int                 @default(1)
  dueDay             Int
  startDate          DateTime            @db.Date
  endDate            DateTime?           @db.Date
  nextGenerationDate DateTime            @db.Date
  isActive           Boolean             @default(true)
  /// Deve identificar membro autorizado deste workspace no momento da criação.
  createdBy          String              @db.Uuid
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator            User                @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  account            Account?            @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  category           Category?           @relation(fields: [workspaceId, categoryId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  transactions       Transaction[]

  @@unique([workspaceId, id])
  @@index([workspaceId, categoryId])
  @@index([workspaceId, accountId])
  @@index([workspaceId, isActive, nextGenerationDate])
  @@index([createdBy])
}

/// CHECKs SQL: closingDay e dueDay entre 1 e 31.
model CreditCard {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String              @db.Uuid
  name              String
  brand             String?
  lastFourDigits    String?             @db.VarChar(4)
  creditLimit       Decimal             @db.Decimal(19, 2)
  closingDay        Int
  dueDay            Int
  ownerMemberId     String?             @db.Uuid
  paymentAccountId  String?             @db.Uuid
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ownerMember       WorkspaceMember?    @relation(fields: [workspaceId, ownerMemberId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  transactions      Transaction[]
  installmentGroups InstallmentGroup[]
  paymentAccount    Account?            @relation(fields: [workspaceId, paymentAccountId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  invoices          CreditCardInvoice[]

  @@unique([workspaceId, id])
  @@index([workspaceId, ownerMemberId])
  @@index([workspaceId, paymentAccountId])
}

model CreditCardInvoice {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String        @db.Uuid
  creditCardId   String        @db.Uuid
  referenceMonth DateTime      @db.Date
  closingDate    DateTime      @db.Date
  dueDate        DateTime      @db.Date
  status         InvoiceStatus @default(OPEN)
  paidAt         DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transactions   Transaction[]
  creditCard     CreditCard    @relation(fields: [workspaceId, creditCardId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workspaceId, id])
  @@unique([creditCardId, referenceMonth])
  @@index([workspaceId, status, dueDate])
  @@index([workspaceId, creditCardId])
}

/// CHECKs SQL: amount positivo e contas de origem/destino diferentes.
model Transfer {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String    @db.Uuid
  sourceAccountId      String    @db.Uuid
  destinationAccountId String    @db.Uuid
  amount               Decimal   @db.Decimal(19, 2)
  transferDate         DateTime  @db.Date
  description          String?
  /// Deve identificar membro autorizado deste workspace no momento da criação.
  createdBy            String    @db.Uuid
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator              User      @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceAccount        Account   @relation("TransferSource", fields: [workspaceId, sourceAccountId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  destinationAccount   Account   @relation("TransferDestination", fields: [workspaceId, destinationAccountId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([workspaceId, transferDate])
  @@index([workspaceId, sourceAccountId])
  @@index([workspaceId, destinationAccountId])
  @@index([createdBy])
}
